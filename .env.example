# Ghost-QA & Self-Healing Sentinel
# Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000

# Google Gemini API (for AI Diagnostics & Code Patching)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# GitHub Integration (PyGithub / Octokit)
GITHUB_TOKEN=your_github_personal_access_token_here
GITHUB_DEFAULT_OWNER=
GITHUB_DEFAULT_REPO=

# Telegram Bot Controller (aiogram 3.x)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Simulation Mode (Fallback when API keys are not provided)
# True allows complete offline demonstration with simulated AI & GitHub PR generation
SIMULATION_MODE=True
