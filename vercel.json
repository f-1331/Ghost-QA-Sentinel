{
  "buildCommand": "cd frontend && npm install --include=dev && npm run build",
  "outputDirectory": "frontend/.next",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://podcast-francis-outer-preventing.trycloudflare.com/api/:match*"
    },
    {
      "source": "/ws/:match*",
      "destination": "https://podcast-francis-outer-preventing.trycloudflare.com/ws/:match*"
    },
    {
      "source": "/screenshots/:match*",
      "destination": "https://podcast-francis-outer-preventing.trycloudflare.com/screenshots/:match*"
    },
    {
      "source": "/sandbox/:match*",
      "destination": "https://podcast-francis-outer-preventing.trycloudflare.com/sandbox/:match*"
    }
  ]
}
